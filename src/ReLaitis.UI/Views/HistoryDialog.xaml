<Window x:Class="ReLaitis.UI.Views.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал истории распознавания"
        Height="480" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Журнал распознавания и отладки" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
            <Button Content="Очистить" HorizontalAlignment="Right" Padding="8,4" FontSize="11" Click="ClearBtn_Click"/>
        </Grid>

        <ListView x:Name="HistoryListView" Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Foreground="#F8FAFC">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Время" Width="70" DisplayMemberBinding="{Binding Time}"/>
                    <GridViewColumn Header="Услышанная фраза" Width="220" DisplayMemberBinding="{Binding Phrase}"/>
                    <GridViewColumn Header="Сработавшая команда" Width="180" DisplayMemberBinding="{Binding CommandName}"/>
                    <GridViewColumn Header="Точность" Width="80" DisplayMemberBinding="{Binding ConfidenceText}"/>
                    <GridViewColumn Header="Процесс" Width="90" DisplayMemberBinding="{Binding Process}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Закрыть" Width="100" Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
