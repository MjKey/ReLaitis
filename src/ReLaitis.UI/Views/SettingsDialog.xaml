<Window x:Class="ReLaitis.UI.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки ReLaitis"
        Height="650" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Системные настройки ReLaitis" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- 1. Движок распознавания речи -->
                <TextBlock Text="ДВИЖОК РАСПОЗНАВАНИЯ РЕЧИ (STT):" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <WrapPanel Margin="0,0,0,10">
                    <RadioButton x:Name="VoskEngineRadio" Content="Vosk (быстрый, 45 МБ)" IsChecked="True" Checked="EngineRadio_Checked" Margin="0,0,16,6"/>
                    <RadioButton x:Name="WhisperEngineRadio" Content="OpenAI Whisper (нейросеть)" Checked="EngineRadio_Checked" Margin="0,0,16,6"/>
                    <RadioButton x:Name="GoogleDuplexEngineRadio" Content="Google Full-Duplex" Checked="EngineRadio_Checked" Margin="0,0,16,6"/>
                    <RadioButton x:Name="SapiEngineRadio" Content="Windows SAPI" Checked="EngineRadio_Checked" Margin="0,0,16,6"/>
                </WrapPanel>

                <!-- Модель Whisper -->
                <StackPanel x:Name="WhisperModelPanel" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock Text="Модель Whisper:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox x:Name="WhisperModelComboBox" Height="32">
                        <ComboBoxItem Content="tiny (75 МБ - легкая)"/>
                        <ComboBoxItem Content="base (142 МБ - рекомендованная)" IsSelected="True"/>
                        <ComboBoxItem Content="small (466 МБ - наивысшая точность)"/>
                    </ComboBox>
                </StackPanel>

                <!-- 2. Аудиовход (Микрофон) -->
                <TextBlock Text="УСТРОЙСТВО ВВОДА (МИКРОФОН):" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <ComboBox x:Name="AudioDeviceComboBox" Height="32" Margin="0,0,0,16"/>

                <!-- 3. Режим активации -->
                <TextBlock Text="РЕЖИМ АКТИВАЦИИ ПРОСЛУШИВАНИЯ:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="ContinuousRadio" Content="Постоянно (всегда)" IsChecked="True" Margin="0,0,14,0"/>
                    <RadioButton x:Name="WakeWordRadio" Content="Wake Word (по фразе)" Margin="0,0,14,0"/>
                    <RadioButton x:Name="PttRadio" Content="Push-to-Talk (по клавише)"/>
                </StackPanel>

                <!-- Фраза активации Wake Word -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Ключевые слова активации (через запятую: лэйтис, джарвис, слушай, эй ты):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="WakeWordBox" Text="лэйтис, джарвис, слушай" Height="32"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Таймаут (сек):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="WakeWordTimeoutBox" Text="6" Height="32"/>
                    </StackPanel>
                </Grid>

                <!-- Клавиша Push-to-Talk -->
                <TextBlock Text="Клавиша Push-to-Talk:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <ComboBox x:Name="PttKeyComboBox" Height="32" Margin="0,0,0,18">
                    <ComboBoxItem Content="CapsLock"/>
                    <ComboBoxItem Content="ScrollLock"/>
                    <ComboBoxItem Content="NumPad0"/>
                    <ComboBoxItem Content="F12"/>
                </ComboBox>

                <!-- 4. СЛУЖБА СИНТЕЗА РЕЧИ (TTS / ОЗВУЧКА) -->
                <Border Background="#162032" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="СЛУЖБА СИНТЕЗА РЕЧИ (ОЗВУЧКА ОТВЕТОВ):" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                        <!-- Выбор провайдера TTS -->
                        <RadioButton x:Name="EdgeTtsRadio" Content="Microsoft Edge Neural (Студийные нейроголоса, бесплатно)" IsChecked="True" Checked="TtsRadio_Checked" Margin="0,0,0,6"/>
                        <RadioButton x:Name="GoogleChromiumTtsRadio" Content="Google Chromium TTS (Translate / v2, без ключа)" Checked="TtsRadio_Checked" Margin="0,0,0,6"/>
                        <RadioButton x:Name="BingTranslatorTtsRadio" Content="Bing Translator TTS (tspeak MP3, без ключа)" Checked="TtsRadio_Checked" Margin="0,0,0,6"/>
                        <RadioButton x:Name="VoiceRssTtsRadio" Content="VoiceRSS TTS" Checked="TtsRadio_Checked" Margin="0,0,0,6"/>
                        <RadioButton x:Name="SapiTtsRadio" Content="Windows SAPI (100% офлайн системные голоса Windows)" Checked="TtsRadio_Checked" Margin="0,0,0,6"/>
                        <RadioButton x:Name="OpenAiTtsRadio" Content="OpenAI TTS (через API ключ)" Checked="TtsRadio_Checked" Margin="0,0,0,12"/>

                        <!-- Голос Edge Neural -->
                        <StackPanel x:Name="EdgeVoicePanel" Margin="0,0,0,10">
                            <TextBlock Text="Нейроголос Edge:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <ComboBox x:Name="EdgeVoiceComboBox" Height="32">
                                <ComboBoxItem Content="ru-RU-SvetlanaNeural (Светлана - женский)" IsSelected="True"/>
                                <ComboBoxItem Content="ru-RU-DmitryNeural (Дмитрий - мужской)"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Голос SAPI -->
                        <StackPanel x:Name="SapiVoicePanel" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock Text="Системный голос Windows SAPI:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <ComboBox x:Name="SapiVoiceComboBox" Height="32"/>
                        </StackPanel>

                        <!-- Настройки OpenAI TTS -->
                        <StackPanel x:Name="OpenAiTtsPanel" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock Text="OpenAI API Key:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBox x:Name="OpenAiApiKeyBox" Height="32" Margin="0,0,0,6"/>
                            <TextBlock Text="Голос OpenAI:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <ComboBox x:Name="OpenAiVoiceComboBox" Height="32">
                                <ComboBoxItem Content="alloy" IsSelected="True"/>
                                <ComboBoxItem Content="nova"/>
                                <ComboBoxItem Content="echo"/>
                                <ComboBoxItem Content="onyx"/>
                                <ComboBoxItem Content="fable"/>
                                <ComboBoxItem Content="shimmer"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Скорость речи и тест -->
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Скорость речи:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                <Slider x:Name="SpeechRateSlider" Minimum="-5" Maximum="5" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="ClearCacheBtn" Content="Очистить кэш" Background="#334155" BorderBrush="#475569" Padding="10,4" Height="32" Margin="0,0,8,0" Click="ClearCacheBtn_Click"/>
                                <Button x:Name="TestTtsBtn" Content="Тест голоса" Background="#0284C7" BorderBrush="#0EA5E9" Padding="12,4" Height="32" Click="TestTtsBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. ПОВЕДЕНИЕ И АВТОЗАПУСК -->
                <TextBlock Text="ПОВЕДЕНИЕ И ОВЕРЛЕЙ:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                <CheckBox x:Name="SoundFeedbackCheckBox" Content="Звуковые сигналы обратной связи (Audio Chimes)" Margin="0,0,0,8" IsChecked="True"/>
                <CheckBox x:Name="AutoStartCheckBox" Content="Запускать ReLaitis вместе с Windows (в трей)" Margin="0,0,0,12"/>

                <!-- 6. HUD оверлей (выключен по умолчанию) -->
                <CheckBox x:Name="ShowHudCheckBox" Content="Показывать плавающий HUD оверлей на рабочем столе" Margin="0,0,0,8"/>
                <TextBlock Text="Прозрачность HUD оверлея:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="HudOpacitySlider" Grid.Column="0" Minimum="0.3" Maximum="1.0" Value="0.95" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ElementName=HudOpacitySlider, Path=Value, StringFormat={}{0:P0}}" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Width="90" Click="CancelBtn_Click" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Width="120" Background="#059669" BorderBrush="#10B981" FontWeight="SemiBold" Click="SaveBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
