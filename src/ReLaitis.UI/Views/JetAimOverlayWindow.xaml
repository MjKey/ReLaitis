<Window x:Class="ReLaitis.UI.Views.JetAimOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JetAim Overlay"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#2A000000"
        Topmost="True"
        ShowInTaskbar="False"
        MouseRightButtonDown="Window_MouseRightButtonDown">
    <Grid>
        <!-- Сетка 1-го уровня (3x3 по всему экрану) -->
        <Grid x:Name="Level1Grid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Секторы 1-9 -->
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="#550EA5E9" BorderThickness="1">
                <TextBlock Text="1" Foreground="#99FFFFFF" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" BorderBrush="#550EA5E9" BorderThickness="1">
                <TextBlock Text="2" Foreground="#99FFFFFF" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="2" BorderBrush="#550EA5E9" BorderThickness="1">
                <TextBlock Text="3" Foreground="#99FFFFFF" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" BorderBrush="#550EA5E9" BorderThickness="1">
                <TextBlock Text="4" Foreground="#99FFFFFF" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" BorderBrush="#550EA5E9" BorderThickness="1">
                <TextBlock Text="5" Foreground="#99FFFFFF" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="1" Grid.Column="2" BorderBrush="#550EA5E9" BorderThickness="1">
                <TextBlock Text="6" Foreground="#99FFFFFF" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" BorderBrush="#550EA5E9" BorderThickness="1">
                <TextBlock Text="7" Foreground="#99FFFFFF" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="2" Grid.Column="1" BorderBrush="#550EA5E9" BorderThickness="1">
                <TextBlock Text="8" Foreground="#99FFFFFF" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="2" Grid.Column="2" BorderBrush="#550EA5E9" BorderThickness="1">
                <TextBlock Text="9" Foreground="#99FFFFFF" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Сетка 2-го уровня (суб-сетка внутри выбранного сектора) -->
        <Canvas x:Name="SubGridCanvas">
            <Border x:Name="SubGridContainer" Background="#CC0F172A" BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="4" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="#8838BDF8" BorderThickness="1">
                        <TextBlock Text="1" Foreground="#38BDF8" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#8838BDF8" BorderThickness="1">
                        <TextBlock Text="2" Foreground="#38BDF8" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" BorderBrush="#8838BDF8" BorderThickness="1">
                        <TextBlock Text="3" Foreground="#38BDF8" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#8838BDF8" BorderThickness="1">
                        <TextBlock Text="4" Foreground="#38BDF8" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#8838BDF8" BorderThickness="1">
                        <TextBlock Text="5" Foreground="#38BDF8" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="#8838BDF8" BorderThickness="1">
                        <TextBlock Text="6" Foreground="#38BDF8" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#8838BDF8" BorderThickness="1">
                        <TextBlock Text="7" Foreground="#38BDF8" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#8838BDF8" BorderThickness="1">
                        <TextBlock Text="8" Foreground="#38BDF8" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" BorderBrush="#8838BDF8" BorderThickness="1">
                        <TextBlock Text="9" Foreground="#38BDF8" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Canvas>

        <!-- Верхний статус-бейдж JetAim с кнопкой закрытия -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                Background="#EE0F172A" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="24" Padding="16,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="InstructionText" Text="JetAim: Назовите сектор 1-9 или нажмите Esc"
                           Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="CancelJetAimBtn" Content="Выход (Esc / ПКМ)" Margin="16,0,0,0"
                        Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#EF4444" BorderThickness="1"
                        Padding="10,4" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="CancelJetAimBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
