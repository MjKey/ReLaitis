<Window x:Class="ReLaitis.UI.Views.CSharpEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор C# скрипта - ReLaitis"
        Height="660" Width="880"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#0B1120"
        Foreground="#F8FAFC">

    <Window.Resources>
        <!-- Стили кнопок -->
        <Style x:Key="ToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button" BasedOn="{StaticResource ToolbarBtnStyle}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="SuccessBtnStyle" TargetType="Button" BasedOn="{StaticResource ToolbarBtnStyle}">
            <Setter Property="Background" Value="#065F46"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="Foreground" Value="#A7F3D0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Верхняя панель (Заголовок) -->
            <RowDefinition Height="Auto"/> <!-- 1. Панель инструментов (Toolbar) -->
            <RowDefinition Height="*"/>    <!-- 2. Центральная зона (Редактор + Сплиттер + Консоль) -->
            <RowDefinition Height="Auto"/> <!-- 3. Нижняя панель (Переменная и кнопки) -->
        </Grid.RowDefinitions>

        <!-- 0. Верхняя панель -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Редактор C# скрипта" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                    <Border Background="#2E1065" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="Roslyn .NET 9" FontSize="10" FontWeight="SemiBold" Foreground="#DDD6FE"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="C# 13 Scripting • Прямой доступ к Win32, Voice, Input, Variables, HttpClient и async/await."
                           FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="CursorPosText" Text="Стр: 1, Кол: 1" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- 1. Панель инструментов -->
        <Border Grid.Row="1" Background="#111C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Кнопка проверки синтаксиса -->
                    <Button x:Name="CheckSyntaxBtn" Style="{StaticResource PrimaryActionBtnStyle}" Margin="0,0,8,0" Click="CheckSyntaxBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Data="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
                            <TextBlock Text="Проверить синтаксис"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка тестового запуска -->
                    <Button x:Name="TestRunBtn" Style="{StaticResource SuccessBtnStyle}" Margin="0,0,8,0" Click="TestRunBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="9" Height="9" Stretch="Uniform" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Data="M2 1.5 L10 6 L2 10.5 Z"/>
                            <TextBlock Text="Тестовый запуск"/>
                        </StackPanel>
                    </Button>

                    <!-- Вставка сниппетов -->
                    <Button x:Name="SnippetsMenuBtn" Style="{StaticResource ToolbarBtnStyle}" Margin="0,0,8,0" Click="SnippetsMenuBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Data="M4 2 C3 2 2 3 2 4 V10 H4 V4 H10 V2 Z M6 6 C5 6 4 7 4 8 V14 C4 15 5 16 6 16 H12 C13 16 14 15 14 14 V8 C14 7 13 6 12 6 Z M6 8 H12 V14 H6 Z"/>
                            <TextBlock Text="Вставить шаблон ▾"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Индикатор статуса компиляции -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="StatusBadge" Text="Готов к проверке" FontSize="12" Foreground="#94A3B8" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Очистить консоль -->
                <Button Grid.Column="2" x:Name="ClearConsoleBtn" Content="Очистить вывод" Style="{StaticResource ToolbarBtnStyle}" Click="ClearConsoleBtn_Click"/>
            </Grid>
        </Border>

        <!-- 2. Центральная зона (Редактор + Сплиттер + Консоль) -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="150"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="2*" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- Редактор кода -->
            <Border Grid.Row="0" Background="#060A12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8">
                <TextBox x:Name="CodeEditorBox"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="13"
                         Background="Transparent"
                         Foreground="#F8FAFC"
                         BorderThickness="0"
                         Padding="12"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         SelectionBrush="#0284C7"
                         CaretBrush="#38BDF8"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         SelectionChanged="CodeEditorBox_SelectionChanged"/>
            </Border>

            <!-- Разделитель сплиттера -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="#1E293B" Cursor="SizeNS"/>

            <!-- Нижняя панель консоли вывода / ошибок -->
            <Border Grid.Row="2" Background="#060A12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0E1726" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,5">
                        <TextBlock Text="КОНСОЛЬ ВЫВОДА И ДИАГНОСТИКИ" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    </Border>

                    <TextBox Grid.Row="1" x:Name="ConsoleBox"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="12"
                             Background="Transparent"
                             Foreground="#94A3B8"
                             BorderThickness="0"
                             Padding="10"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Нижняя панель (Переменная и кнопки) -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Сохранить return в переменную:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="ResultVarBox" Height="32" Padding="8,5" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="12"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Content="Отмена" Width="90" Height="34" Margin="0,0,10,0" Style="{StaticResource ToolbarBtnStyle}" Click="CancelBtn_Click"/>
                <Button Content="Сохранить код" Width="130" Height="34" Style="{StaticResource PrimaryActionBtnStyle}" Click="SaveBtn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
