<Window x:Class="ReLaitis.UI.Views.AddCommandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать новую голосовую команду"
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Заголовок -->
            <RowDefinition Height="Auto"/> <!-- Имя команды -->
            <RowDefinition Height="Auto"/> <!-- Категория -->
            <RowDefinition Height="*"/>    <!-- Фразы-триггеры -->
            <RowDefinition Height="Auto"/> <!-- Кнопки -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Новая голосовая команда" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,16"/>

        <!-- Название команды -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Название команды:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <TextBox x:Name="CommandNameBox" Height="30" Text="Новая команда"/>
        </StackPanel>

        <!-- Категория -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Категория (группа):" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <TextBox x:Name="CategoryBox" Height="30" Text="Общие"/>
        </StackPanel>

        <!-- Фразы активации -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Фразы активации (по одной на строку, синонимы):" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <TextBox x:Name="PhrasesBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="Поддерживаются слоты: например, 'открой {приложение}' или 'громкость {значение}%'."
                       FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Отмена" Width="90" Click="CancelBtn_Click" Margin="0,0,10,0"/>
            <Button Content="Создать" Width="100" Background="#0284C7" BorderBrush="#0EA5E9" FontWeight="SemiBold" Click="CreateBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
