<Window x:Class="ReLaitis.UI.Views.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReLaitis HUD"
        Height="72" Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#F20B0F19"
            BorderBrush="#38BDF8"
            BorderThickness="1.2"
            CornerRadius="16"
            Margin="6"
            Padding="14,8"
            Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.8" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Статус LED и микрофонный индикатор -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <Grid Width="16" Height="16" Margin="0,0,0,4">
                    <Ellipse x:Name="StatusLedGlow" Width="16" Height="16" Fill="#2010B981"/>
                    <Ellipse x:Name="StatusLed" Width="10" Height="10" Fill="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Border Background="#1E293B" CornerRadius="3" Padding="1">
                    <ProgressBar x:Name="MicLevelBar" Width="14" Height="22" Orientation="Vertical"
                                 Minimum="0" Maximum="1" Value="0"
                                 Foreground="#38BDF8" Background="Transparent" BorderThickness="0"/>
                </Border>
            </StackPanel>

            <!-- Распознанный текст и статус выполнения -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="RecognizedText"
                           Text="ReLaitis готов к работе"
                           Foreground="#F8FAFC"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="ActionStatusText"
                           Text="Слушаю..."
                           Foreground="#94A3B8"
                           FontSize="11"
                           Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Кнопка скрытия HUD -->
            <Button Grid.Column="2" Content="✕" Width="20" Height="20" Padding="0"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Background="Transparent" BorderBrush="Transparent" Foreground="#64748B"
                    FontSize="10" Cursor="Hand" Click="CloseHudBtn_Click" ToolTip="Скрыть HUD (включить можно кнопкой 'HUD' в приложении)"/>
        </Grid>
    </Border>
</Window>
